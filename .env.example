# Copy to .env.local for local dev. Set the same names in Vercel > Project > Settings > Environment Variables.
# Never commit real values.

# Password for the whole site (pages + read APIs).
OFFICE_PASSWORD=

# Bearer token bots use for POST /api/status and POST /api/usage. Generate with: openssl rand -hex 32
OFFICE_PUSH_TOKEN=

# Neon Postgres connection string. Leave empty locally to use the file store in .data/office-store.json.
DATABASE_URL=

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/heartbeat. Generate with: openssl rand -hex 32
CRON_SECRET=

# Optional: separate key for signing session cookies (defaults to deriving from OFFICE_PASSWORD).
SESSION_SECRET=

# Optional: minutes without a heartbeat before the "heartbeat stopped" warning (default 20).
HEARTBEAT_STALE_MINUTES=

# Optional provider keys (server-side only). Without a key, that source shows "Not connected".
# Cursor user API key for the Cloud Agents API (contractors in Engineering).
CURSOR_API_KEY=
# Cursor Admin API key (team spend row; Cursor team plan only).
CURSOR_ADMIN_API_KEY=
# OpenAI organization Admin key (sk-admin-...).
OPENAI_ADMIN_KEY=
# Anthropic Admin API key (sk-ant-admin01-...).
ANTHROPIC_ADMIN_KEY=

# Used only by the bot CLI scripts (scripts/office-status.sh, scripts/office-status.mjs).
OFFICE_URL=http://localhost:5173
